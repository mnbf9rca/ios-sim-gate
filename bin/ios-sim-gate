#!/usr/bin/env bash

set -euo pipefail

STATE_ROOT="${IOS_SIM_GATE_HOME:-$HOME/Library/Application Support/ios-sim-gate}"
LOCK_ROOT="$STATE_ROOT/locks"
REGISTRY="$STATE_ROOT/registry.json"
FLOCK_BIN="${IOS_SIM_GATE_FLOCK_BIN:-/opt/homebrew/bin/flock}"
JQ_BIN="${IOS_SIM_GATE_JQ_BIN:-/opt/homebrew/bin/jq}"
WAIT_SECONDS="${IOS_SIM_GATE_WAIT_SECONDS:-1800}"
CACHE_ROOT="${IOS_SIM_GATE_CACHE_HOME:-$HOME/Library/Caches/ios-sim-gate}"
SIMCTL_BIN="${IOS_SIM_GATE_SIMCTL_BIN:-}"
STALE_SECONDS="${IOS_SIM_GATE_STALE_SECONDS:-604800}"
CAP="${IOS_SIM_GATE_CAP:-3}"

die() {
  printf 'ios-sim-gate: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
ios-sim-gate — machine-wide Xcode simulator registry and run gate

Usage:
  ios-sim-gate register --project NAME --agent NAME [--session NAME] --udid UUID
  ios-sim-gate run --project NAME --agent NAME [--session NAME] --udid UUID -- COMMAND [ARG ...]
  ios-sim-gate status
  ios-sim-gate cleanup
  ios-sim-gate reconcile
USAGE
}

require_executable() {
  [ -x "$1" ] || die "required executable not found: $1"
}

validate_wait_seconds() {
  case "$WAIT_SECONDS" in
    0|[1-9]|[1-9][0-9]*) ;;
    *) die "IOS_SIM_GATE_WAIT_SECONDS must be a canonical non-negative integer" ;;
  esac
}

validate_stale_seconds() {
  case "$STALE_SECONDS" in
    0|[1-9]|[1-9][0-9]*) ;;
    *) die "IOS_SIM_GATE_STALE_SECONDS must be a canonical non-negative integer" ;;
  esac
}

validate_capacity() {
  case "$CAP" in
    1|2|3) ;;
    *) die "IOS_SIM_GATE_CAP must be between 1 and 3" ;;
  esac
}

validate_identifier() {
  local label="$1"
  local value="$2"
  [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
    die "invalid $label: $value"
}

validate_uuid() {
  [[ "$1" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] ||
    die "invalid simulator UUID: $1"
}

now_utc() {
  if [ -n "${IOS_SIM_GATE_NOW:-}" ]; then
    printf '%s\n' "$IOS_SIM_GATE_NOW"
  else
    /bin/date -u '+%Y-%m-%dT%H:%M:%SZ'
  fi
}

timestamp_epoch() {
  /bin/date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" '+%s' 2>/dev/null ||
    die "could not parse registry timestamp: $1"
}

simctl() {
  if [ -n "$SIMCTL_BIN" ]; then
    "$SIMCTL_BIN" "$@"
  else
    /usr/bin/xcrun simctl "$@"
  fi
}

require_simctl() {
  if [ -n "$SIMCTL_BIN" ]; then
    require_executable "$SIMCTL_BIN"
  else
    require_executable /usr/bin/xcrun
  fi
}

ensure_state() {
  umask 077
  mkdir -p "$LOCK_ROOT/slots" "$LOCK_ROOT/simulators"
  chmod 700 "$STATE_ROOT" "$LOCK_ROOT" "$LOCK_ROOT/slots" "$LOCK_ROOT/simulators"
  touch "$LOCK_ROOT/admission.lock" "$LOCK_ROOT/registry.lock"
  touch "$LOCK_ROOT/slots/1.lock" "$LOCK_ROOT/slots/2.lock" "$LOCK_ROOT/slots/3.lock"
}

acquire_registry_lock() {
  local flock_rc=0

  exec 6>>"$LOCK_ROOT/registry.lock"
  if [ "$WAIT_SECONDS" -eq 0 ]; then
    "$FLOCK_BIN" -n -x 6 || flock_rc=$?
  else
    "$FLOCK_BIN" -x -w "$WAIT_SECONDS" 6 || flock_rc=$?
  fi
  case "$flock_rc" in
    0) ;;
    1) die "timed out after ${WAIT_SECONDS}s waiting for registry lock" ;;
    *) die "could not acquire registry lock (flock status $flock_rc)" ;;
  esac
}

ensure_registry_exists() {
  if [ ! -e "$REGISTRY" ]; then
    printf '{}\n' >"$REGISTRY"
    chmod 600 "$REGISTRY"
  fi
}

validate_registry() {
  # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
  "$JQ_BIN" -e '
    type == "object" and
    all(
      to_entries[];
      (.key | test("^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$")) and
      (.value | type == "object") and
      (.value.project | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
      (.value.agent | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
      (.value.lastupdated | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
      ((.value | has("session") | not) or
       (.value.session | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"))) and
      ([.value | keys[]] - ["agent", "lastupdated", "project", "session"] | length == 0)
    ) and
    (
      [to_entries[] | [.value.project, .value.agent, (.value.session // "")]] as $owners |
      ($owners | length) == ($owners | unique | length)
    )
  ' "$REGISTRY" >/dev/null 2>&1 || die "registry is invalid: $REGISTRY"
}

write_registry_entry() {
  local uuid="$1"
  local project="$2"
  local agent="$3"
  local session="$4"
  local timestamp="$5"
  local entry
  local temporary

  entry="$(
    # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
    "$JQ_BIN" -n \
      --arg project "$project" \
      --arg agent "$agent" \
      --arg session "$session" \
      --arg lastupdated "$timestamp" \
      '{project: $project, agent: $agent, lastupdated: $lastupdated} +
       (if $session == "" then {} else {session: $session} end)'
  )"
  temporary="$(mktemp "$STATE_ROOT/.registry.XXXXXX")"
  # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
  if ! "$JQ_BIN" --arg uuid "$uuid" --argjson entry "$entry" \
    '.[$uuid] = $entry' "$REGISTRY" >"$temporary"; then
    rm -f "$temporary"
    die "could not update registry"
  fi
  chmod 600 "$temporary"
  mv "$temporary" "$REGISTRY"
}

remove_registry_entry() {
  local uuid="$1"
  local temporary

  temporary="$(mktemp "$STATE_ROOT/.registry.XXXXXX")"
  # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
  if ! "$JQ_BIN" --arg uuid "$uuid" 'del(.[$uuid])' "$REGISTRY" >"$temporary"; then
    rm -f "$temporary"
    die "could not update registry"
  fi
  chmod 600 "$temporary"
  mv "$temporary" "$REGISTRY"
}

load_inventory() {
  local target="$1"
  shift

  if ! simctl "$@" >"$target"; then
    die "simctl inventory failed: $*"
  fi
  # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
  "$JQ_BIN" -e '
    .devices | type == "object" and
    all(.[]; type == "array" and all(.[]; (.udid | type == "string")))
  ' "$target" >/dev/null 2>&1 || die "simctl returned an invalid device inventory"
}

inventory_rows() {
  # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
  "$JQ_BIN" -r '
    .devices[]?[]? |
    [.udid, (.name // "unknown"), (.state // "unknown"), (.dataPathSize // 0)] | @tsv
  ' "$1"
}

inventory_has_uuid() {
  local inventory="$1"
  local uuid="$2"
  # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
  "$JQ_BIN" -e --arg uuid "$uuid" \
    'any(.devices[]?[]?; .udid == $uuid)' "$inventory" >/dev/null
}

try_uuid_lock() {
  local uuid="$1"
  exec 5>>"$LOCK_ROOT/simulators/$uuid.lock"
  "$FLOCK_BIN" -n -x 5
}

delete_simulator_locked() {
  local uuid="$1"

  validate_uuid "$uuid"
  simctl shutdown "$uuid" >/dev/null 2>&1 || true
  simctl delete "$uuid" >/dev/null
}

cleanup_locked() {
  local normal_inventory
  local testing_inventory
  local uuid
  local name
  local state
  local bytes
  local owner
  local updated
  local now_epoch
  local updated_epoch

  normal_inventory="$(mktemp "$STATE_ROOT/.devices.XXXXXX")"
  testing_inventory="$(mktemp "$STATE_ROOT/.testing-devices.XXXXXX")"
  load_inventory "$normal_inventory" list devices --json
  load_inventory "$testing_inventory" --set testing list devices --json
  now_epoch="$(timestamp_epoch "$(now_utc)")"

  while IFS=$'\t' read -r uuid name state bytes; do
    validate_uuid "$uuid"
    # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
    owner="$("$JQ_BIN" -r --arg uuid "$uuid" \
      'if has($uuid) then
         [.[$uuid].project, .[$uuid].agent, (.[$uuid].session // "default")] | join("/")
       else "" end' "$REGISTRY")"

    if [ -n "$owner" ]; then
      # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
      updated="$("$JQ_BIN" -r --arg uuid "$uuid" '.[$uuid].lastupdated' "$REGISTRY")"
      updated_epoch="$(timestamp_epoch "$updated")"
      if [ $((now_epoch - updated_epoch)) -le "$STALE_SECONDS" ]; then
        continue
      fi
    fi

    if ! try_uuid_lock "$uuid"; then
      printf 'cleanup skip uuid=%s reason=locked\n' "$uuid" >&2
      exec 5>&-
      continue
    fi

    validate_registry
    if [ -n "$owner" ]; then
      # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
      updated="$("$JQ_BIN" -r --arg uuid "$uuid" '.[$uuid].lastupdated // ""' "$REGISTRY")"
      if [ -z "$updated" ]; then
        exec 5>&-
        continue
      fi
      updated_epoch="$(timestamp_epoch "$updated")"
      if [ $((now_epoch - updated_epoch)) -le "$STALE_SECONDS" ]; then
        exec 5>&-
        continue
      fi
    elif "$JQ_BIN" -e --arg uuid "$uuid" "has(\$uuid)" "$REGISTRY" >/dev/null; then
      exec 5>&-
      continue
    fi

    if delete_simulator_locked "$uuid"; then
      printf 'cleanup delete uuid=%s owner=%s name=%s reason=%s bytes=%s\n' \
        "$uuid" "${owner:-unregistered}" "$name" \
        "$([ -n "$owner" ] && printf stale || printf unregistered)" "$bytes" >&2
      [ -z "$owner" ] || remove_registry_entry "$uuid"
    else
      printf 'cleanup error uuid=%s reason=simctl-delete-failed\n' "$uuid" >&2
    fi
    exec 5>&-
  done < <(inventory_rows "$normal_inventory")

  while IFS=$'\t' read -r uuid name state bytes; do
    printf 'cleanup skip uuid=%s name=%s state=%s bytes=%s reason=testing-set-report-only\n' \
      "$uuid" "$name" "$state" "$bytes" >&2
  done < <(inventory_rows "$testing_inventory")

  while IFS= read -r uuid; do
    if inventory_has_uuid "$normal_inventory" "$uuid" ||
       inventory_has_uuid "$testing_inventory" "$uuid"; then
      continue
    fi
    if ! try_uuid_lock "$uuid"; then
      printf 'cleanup skip uuid=%s reason=locked\n' "$uuid" >&2
      exec 5>&-
      continue
    fi
    validate_registry
    if ! inventory_has_uuid "$normal_inventory" "$uuid" &&
       ! inventory_has_uuid "$testing_inventory" "$uuid"; then
      # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
      owner="$("$JQ_BIN" -r --arg uuid "$uuid" \
        '[.[$uuid].project, .[$uuid].agent, (.[$uuid].session // "default")] | join("/")' \
        "$REGISTRY")"
      remove_registry_entry "$uuid"
      printf 'cleanup prune uuid=%s owner=%s reason=simulator-missing bytes=0\n' \
        "$uuid" "$owner" >&2
    fi
    exec 5>&-
  done < <("$JQ_BIN" -r 'keys[]' "$REGISTRY")

  rm -f "$normal_inventory" "$testing_inventory"
}

cleanup_command() {
  [ "$#" -eq 0 ] || die "cleanup takes no arguments"
  ensure_state
  require_simctl
  validate_stale_seconds
  acquire_registry_lock
  ensure_registry_exists
  validate_registry
  cleanup_locked
  exec 6>&-
}

lock_status() {
  local lock_path="$1"
  local pids=""

  exec 5>>"$lock_path"
  if "$FLOCK_BIN" -n -x 5; then
    exec 5>&-
    printf 'free'
    return
  fi
  exec 5>&-
  if [ -x /usr/sbin/lsof ]; then
    pids="$(/usr/sbin/lsof -t "$lock_path" 2>/dev/null | sort -u | paste -sd, -)"
  fi
  printf 'held%s' "${pids:+ pids=$pids}"
}

status_command() {
  local normal_inventory
  local testing_inventory
  local uuid
  local name
  local state
  local bytes
  local owner
  local lock
  local pid

  [ "$#" -eq 0 ] || die "status takes no arguments"
  ensure_state
  require_simctl
  acquire_registry_lock
  ensure_registry_exists
  validate_registry
  normal_inventory="$(mktemp "$STATE_ROOT/.devices.XXXXXX")"
  testing_inventory="$(mktemp "$STATE_ROOT/.testing-devices.XXXXXX")"
  load_inventory "$normal_inventory" list devices --json
  load_inventory "$testing_inventory" --set testing list devices --json

  printf 'capacity slots=%s admission=%s\n' "$CAP" "$(lock_status "$LOCK_ROOT/admission.lock")"
  for uuid in 1 2 3; do
    printf 'slot=%s lock=%s\n' "$uuid" "$(lock_status "$LOCK_ROOT/slots/$uuid.lock")"
  done
  while IFS=$'\t' read -r uuid name state bytes; do
    # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
    owner="$("$JQ_BIN" -r --arg uuid "$uuid" \
      'if has($uuid) then
         [.[$uuid].project, .[$uuid].agent, (.[$uuid].session // "default")] | join("/")
       else "unregistered" end' "$REGISTRY")"
    lock="$(lock_status "$LOCK_ROOT/simulators/$uuid.lock")"
    printf 'uuid=%s owner=%s name=%s state=%s bytes=%s lock=%s\n' \
      "$uuid" "$owner" "$name" "$state" "$bytes" "$lock"
    while IFS= read -r pid; do
      [ -n "$pid" ] || continue
      printf '  process '
      /bin/ps -p "$pid" -o pid=,ppid=,command= 2>/dev/null || printf 'pid=%s\n' "$pid"
    done < <(/usr/bin/pgrep -f "$uuid" 2>/dev/null || true)
  done < <(inventory_rows "$normal_inventory")
  while IFS=$'\t' read -r uuid name state bytes; do
    printf 'uuid=%s owner=testing-set-report-only name=%s state=%s bytes=%s lock=%s\n' \
      "$uuid" "$name" "$state" "$bytes" "$(lock_status "$LOCK_ROOT/simulators/$uuid.lock")"
  done < <(inventory_rows "$testing_inventory")
  while IFS= read -r uuid; do
    if ! inventory_has_uuid "$normal_inventory" "$uuid" &&
       ! inventory_has_uuid "$testing_inventory" "$uuid"; then
      # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
      owner="$("$JQ_BIN" -r --arg uuid "$uuid" \
        '[.[$uuid].project, .[$uuid].agent, (.[$uuid].session // "default")] | join("/")' \
        "$REGISTRY")"
      printf 'uuid=%s owner=%s state=missing lock=%s\n' \
        "$uuid" "$owner" "$(lock_status "$LOCK_ROOT/simulators/$uuid.lock")"
    fi
  done < <("$JQ_BIN" -r 'keys[]' "$REGISTRY")

  rm -f "$normal_inventory" "$testing_inventory"
  exec 6>&-
}

register_simulator() {
  local project=""
  local agent=""
  local session=""
  local uuid=""
  local existing_owner
  local duplicate_uuid
  local timestamp

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) shift; [ "$#" -gt 0 ] || die "--project requires a value"; project="$1" ;;
      --agent) shift; [ "$#" -gt 0 ] || die "--agent requires a value"; agent="$1" ;;
      --session) shift; [ "$#" -gt 0 ] || die "--session requires a value"; session="$1" ;;
      --udid) shift; [ "$#" -gt 0 ] || die "--udid requires a value"; uuid="$1" ;;
      *) die "unknown register argument: $1" ;;
    esac
    shift
  done

  [ -n "$project" ] || die "register requires --project"
  [ -n "$agent" ] || die "register requires --agent"
  [ -n "$uuid" ] || die "register requires --udid"
  validate_identifier project "$project"
  validate_identifier agent "$agent"
  [ -z "$session" ] || validate_identifier session "$session"
  validate_uuid "$uuid"

  ensure_state
  acquire_registry_lock
  ensure_registry_exists
  validate_registry

  existing_owner="$(
    # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
    "$JQ_BIN" -r --arg uuid "$uuid" \
      'if has($uuid) then
         [.[$uuid].project, .[$uuid].agent, (.[$uuid].session // "")] | @tsv
       else "" end' "$REGISTRY"
  )"
  if [ -n "$existing_owner" ] &&
     [ "$existing_owner" != "$(printf '%s\t%s\t%s' "$project" "$agent" "$session")" ]; then
    die "simulator $uuid is registered to another owner"
  fi

  duplicate_uuid="$(
    # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
    "$JQ_BIN" -r \
      --arg uuid "$uuid" \
      --arg project "$project" \
      --arg agent "$agent" \
      --arg session "$session" \
      'to_entries[] |
       select(
         .key != $uuid and
         .value.project == $project and
         .value.agent == $agent and
         (.value.session // "") == $session
       ) |
       .key' "$REGISTRY"
  )"
  [ -z "$duplicate_uuid" ] ||
    die "$project/$agent/${session:-default} already owns simulator $duplicate_uuid"

  timestamp="$(now_utc)"
  write_registry_entry "$uuid" "$project" "$agent" "$session" "$timestamp"
  printf 'registered %s to %s/%s/%s\n' "$uuid" "$project" "$agent" "${session:-default}"
}

parse_run_arguments() {
  RUN_PROJECT=""
  RUN_AGENT=""
  RUN_SESSION=""
  RUN_UUID=""
  RUN_COMMAND=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) shift; [ "$#" -gt 0 ] || die "--project requires a value"; RUN_PROJECT="$1" ;;
      --agent) shift; [ "$#" -gt 0 ] || die "--agent requires a value"; RUN_AGENT="$1" ;;
      --session) shift; [ "$#" -gt 0 ] || die "--session requires a value"; RUN_SESSION="$1" ;;
      --udid) shift; [ "$#" -gt 0 ] || die "--udid requires a value"; RUN_UUID="$1" ;;
      --) shift; RUN_COMMAND=("$@"); break ;;
      *) die "unknown run argument: $1" ;;
    esac
    shift
  done

  [ -n "$RUN_PROJECT" ] || die "run requires --project"
  [ -n "$RUN_AGENT" ] || die "run requires --agent"
  [ -n "$RUN_UUID" ] || die "run requires --udid"
  [ "${#RUN_COMMAND[@]}" -gt 0 ] || die "run requires a command after --"
  validate_identifier project "$RUN_PROJECT"
  validate_identifier agent "$RUN_AGENT"
  [ -z "$RUN_SESSION" ] || validate_identifier session "$RUN_SESSION"
  validate_uuid "$RUN_UUID"
}

validate_run_owner() {
  local expected_owner
  local registered_owner

  expected_owner="$(printf '%s\t%s\t%s' "$RUN_PROJECT" "$RUN_AGENT" "$RUN_SESSION")"
  # shellcheck disable=SC2016 # jq expressions intentionally use jq variables.
  registered_owner="$(
    "$JQ_BIN" -r --arg uuid "$RUN_UUID" \
      'if has($uuid) then
         [.[$uuid].project, .[$uuid].agent, (.[$uuid].session // "")] | @tsv
       else "" end' "$REGISTRY"
  )"
  [ "$registered_owner" = "$expected_owner" ] ||
    die "$RUN_PROJECT/$RUN_AGENT/${RUN_SESSION:-default} does not own simulator $RUN_UUID"
}

remaining_wait_seconds() {
  local elapsed=$((SECONDS - RUN_STARTED_AT))
  local remaining=$((WAIT_SECONDS - elapsed))
  if [ "$remaining" -lt 0 ]; then
    remaining=0
  fi
  printf '%s\n' "$remaining"
}

acquire_run_lock() {
  local label="$1"
  local mode="$2"
  local descriptor="$3"
  local flock_rc=0
  local remaining

  remaining="$(remaining_wait_seconds)"
  if [ "$remaining" -eq 0 ]; then
    "$FLOCK_BIN" -n "$mode" "$descriptor" || flock_rc=$?
  else
    "$FLOCK_BIN" "$mode" -w "$remaining" "$descriptor" || flock_rc=$?
  fi
  case "$flock_rc" in
    0) ;;
    1) die "timed out after ${WAIT_SECONDS}s waiting for $label" ;;
    *) die "could not acquire $label (flock status $flock_rc)" ;;
  esac
}

acquire_global_slot() {
  local checksum
  local offset
  local slot
  local flock_rc

  checksum="$(printf '%s' "$RUN_UUID" | cksum)"
  checksum="${checksum%% *}"
  for ((offset = 0; offset < CAP; offset++)); do
    slot=$(((checksum + offset) % CAP + 1))
    exec 9>>"$LOCK_ROOT/slots/$slot.lock"
    flock_rc=0
    "$FLOCK_BIN" -n -x 9 || flock_rc=$?
    if [ "$flock_rc" -eq 0 ]; then
      IOS_SIM_GATE_SLOT="$slot"
      export IOS_SIM_GATE_SLOT
      return
    fi
    exec 9>&-
  done

  slot=$((checksum % CAP + 1))
  exec 9>>"$LOCK_ROOT/slots/$slot.lock"
  acquire_run_lock "global simulator slot" -x 9
  IOS_SIM_GATE_SLOT="$slot"
  export IOS_SIM_GATE_SLOT
}

refresh_run_owner() {
  acquire_registry_lock
  ensure_registry_exists
  validate_registry
  cleanup_locked
  validate_run_owner
  write_registry_entry "$RUN_UUID" "$RUN_PROJECT" "$RUN_AGENT" "$RUN_SESSION" "$(now_utc)"
  exec 6>&-
}

run_command() {
  local derived_data_path

  parse_run_arguments "$@"
  ensure_state
  require_simctl
  validate_stale_seconds

  acquire_registry_lock
  ensure_registry_exists
  validate_registry
  validate_run_owner
  exec 6>&-

  RUN_STARTED_AT=$SECONDS
  exec 8>>"$LOCK_ROOT/simulators/$RUN_UUID.lock"
  acquire_run_lock "simulator $RUN_UUID" -x 8
  exec 7>>"$LOCK_ROOT/admission.lock"
  acquire_run_lock "shared admission lock" -s 7
  acquire_global_slot
  refresh_run_owner

  derived_data_path="$CACHE_ROOT/DerivedData/$RUN_PROJECT/$RUN_AGENT/${RUN_SESSION:-default}"
  mkdir -p "$derived_data_path"
  export IOS_SIM_GATE_UDID="$RUN_UUID"
  export IOS_SIM_GATE_DESTINATION="platform=iOS Simulator,id=$RUN_UUID"
  export IOS_SIM_GATE_DERIVED_DATA_PATH="$derived_data_path"
  export IOS_SIM_GATE_PROJECT="$RUN_PROJECT"
  export IOS_SIM_GATE_AGENT="$RUN_AGENT"
  export IOS_SIM_GATE_SESSION="$RUN_SESSION"

  exec "${RUN_COMMAND[@]}"
}

require_executable "$FLOCK_BIN"
require_executable "$JQ_BIN"
validate_wait_seconds
validate_capacity

case "${1:-}" in
  register) shift; register_simulator "$@" ;;
  run) shift; run_command "$@" ;;
  status) shift; status_command "$@" ;;
  cleanup|reconcile) shift; cleanup_command "$@" ;;
  -h|--help) usage ;;
  "") usage >&2; exit 1 ;;
  *) die "unknown command: $1" ;;
esac
